      "id": "63201607-50fe-407b-b1d1-b4e8ca6bf9c4",
      "name": "Get Existing IDs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        300
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "onError": "continueErrorOutput",
      "notes": "Pick your Google Sheets credential. Nothing else to change. Reads the sheet to find today's last ID.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// No edits needed here. Business and owner name come from the 'Config' node.\nconst cfg = $('Config').first().json;\nconst BUSINESS_NAME = cfg.businessName;\nconst OWNER_NAME = cfg.ownerName;\nconst TZ = 'Africa/Nairobi';\nconst emailRe = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\nconst clean = v => String(v === undefined || v === null ? '' : v).trim();\n\nconst triggerItems = $('New Enquiry Row').all();\nconst sheetRows = $('Get Existing IDs').all().map(i => i.json);\nconst now = $now.setZone(TZ);\nconst prefix = 'ENQ-' + now.toFormat('yyyyLLdd') + '-';\n\n// highest sequence already used today\nlet maxSeq = 0;\nfor (const r of sheetRows) {\n  const id = clean(r['Enquiry ID']);\n  if (id.startsWith(prefix)) {\n    const n = parseInt(id.slice(prefix.length), 10);\n    if (!isNaN(n) && n > maxSeq) maxSeq = n;\n  }\n}\n\nconst usedRows = new Set();\nconst out = [];\nfor (const item of triggerItems) {\n  const j = item.json;\n  // skip rows that already have an Enquiry ID (already processed)\n  if (clean(j['Enquiry ID'])) continue;\n  const fullName = clean(j['Full Name']);\n  const email = clean(j['Email']);\n  const phone = clean(j['Phone']) || 'Not provided';\n  const service = clean(j['Service Needed']) || 'General enquiry';\n  const message = clean(j['Message']);\n\n  // locate this row's number in the sheet (needed to update the right row)\n  let rowNumber = j.row_number || null;\n  if (!rowNumber) {\n    const match = sheetRows.find(r =>\n      !usedRows.has(r.row_number) &&\n      !clean(r['Enquiry ID']) &&\n      clean(r['Timestamp']) === clean(j['Timestamp']) &&\n      clean(r['Email']) === email &&\n      clean(r['Message']) === message);\n    if (match) { rowNumber = match.row_number; usedRows.add(rowNumber); }\n  }\n\n  maxSeq += 1;\n  const enquiryId = prefix + String(maxSeq).padStart(3, '0');\n\n  const problems = [];\n  if (!fullName) problems.push('Full Name is empty');\n  if (!email) problems.push('Email is empty');\n  else if (!emailRe.test(email)) problems.push('Email is not valid');\n  if (!message) problems.push('Message is empty');\n  if (!rowNumber) problems.push('Could not locate the sheet row');\n\n  out.push({ json: {\n    enquiryId, rowNumber, fullName, email, phone, service, message,\n    dateReceived: now.toFormat('yyyy-MM-dd HH:mm'),\n    valid: problems.length === 0,\n    reason: problems.join('; '),\n    businessName: BUSINESS_NAME,\n    ownerName: OWNER_NAME\n  }});\n}\nreturn out;"
      },
